#!/usr/bin/env python3
import tkinter as tk

root = tk.Tk()
root.title("LinDOS System Monitor")
root.geometry("350x250")
root.configure(bg="#1e1e2e")

lbl_title = tk.Label(root, text="System & ZRAM Telemetry", bg="#1e1e2e", fg="#89b4fa", font=('Sans', 11, 'bold'))
lbl_title.pack(pady=10)

info_frame = tk.Frame(root, bg="#11111b", bd=2, relief='groove')
info_frame.pack(fill='both', expand=True, padx=15, pady=10)

text_info = tk.Text(info_frame, bg="#11111b", fg="#a6e3a1", font=('Courier', 9), bd=0)
text_info.pack(fill='both', expand=True, padx=10, pady=10)

text_info.insert(tk.END, "OS Core: LinDOS v1.0-beta\n")
text_info.insert(tk.END, "Architecture: x86_64 Minimal\n")
text_info.insert(tk.END, "ZRAM Status: Active (LZ4 Compression)\n")
text_info.insert(tk.END, "Memory Pool: Optimized (4GB Budget)\n")
text_info.insert(tk.END, "CPU Governor: Performance Mode\n")
text_info.config(state=tk.DISABLED)

root.mainloop()
