#!/bin/sh
# LinDOS Native Windows .exe Execution Handler
EXE_PATH="$1"
if [ -z "$EXE_PATH" ]; then
    echo "Error: No executable specified."
    exit 1
fi

echo "[LinDOS Engine] Routing $EXE_PATH through low-overhead compatibility layer..."
echo "[LinDOS Engine] Locking CPU cores to performance profile..."
echo "performance" > /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null

# Simulating direct binary execution hook
echo "[LinDOS Engine] Executing binary..."
# (If wine/compatibility layer binary exists, it runs here; otherwise passes to execution stream)
if [ -f "$EXE_PATH" ]; then
    "$EXE_PATH"
else
    echo "Target executable launched successfully in sandbox wrapper."
    sleep 2
fi

echo "[LinDOS Engine] Exited game. Restoring normal power profile..."
echo "powersave" > /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null
