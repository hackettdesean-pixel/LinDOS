#!/usr/bin/env python3
import tkinter as tk

root = tk.Tk()
root.title("LinDOS Calculator")
root.geometry("280x350")
root.configure(bg="#1e1e2e")

entry = tk.Entry(root, font=('Sans', 18), bg="#11111b", fg="#cdd6f4", justify="right", bd=0)
entry.pack(fill='x', padx=10, pady=15, ipady=8)

btns_frame = tk.Frame(root, bg="#1e1e2e")
btns_frame.pack(fill='both', expand=True, padx=10, pady=5)

buttons = [
    ('7', 0, 0), ('8', 0, 1), ('9', 0, 2), ('/', 0, 3),
    ('4', 1, 0), ('5', 1, 1), ('6', 1, 2), ('*', 1, 3),
    ('1', 2, 0), ('2', 2, 1), ('3', 2, 2), ('-', 2, 3),
    ('0', 3, 0), ('.', 3, 1), ('+', 3, 2), ('=', 3, 3)
]

def click(val):
    if val == '=':
        try:
            res = eval(entry.get())
            entry.delete(0, tk.END)
            entry.insert(tk.END, str(res))
        except:
            entry.delete(0, tk.END)
            entry.insert(tk.END, "Error")
    else:
        entry.insert(tk.END, val)

for (text, row, col) in buttons:
    b = tk.Button(btns_frame, text=text, font=('Sans', 12, 'bold'), bg="#313244", fg="#cdd6f4", relief='flat', command=lambda t=text: click(t))
    b.grid(row=row, column=col, sticky="nsew", padx=3, pady=3)

for i in range(4):
    btns_frame.rowconfigure(i, weight=1)
    btns_frame.columnconfigure(i, weight=1)

root.mainloop()
