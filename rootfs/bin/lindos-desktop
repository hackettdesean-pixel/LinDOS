#!/usr/bin/env python3
import tkinter as tk
from datetime import datetime

class LinDOSDesktop(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("LinDOS Desktop Environment")
        self.attributes('-fullscreen', True)  # Fullscreen OS desktop view
        self.configure(bg="#0f111a")

        # Configure keyboard shortcut to exit desktop (Ctrl+Q or Escape)
        self.bind("<Control-q>", lambda e: self.destroy())
        self.bind("<Escape>", lambda e: self.toggle_menu(force_close=True))

        # Build Desktop Components
        self.create_desktop_area()
        self.create_taskbar()
        self.create_menu_popup()

    def create_desktop_area(self):
        # Main desktop background canvas for mouse clicks & icons
        self.desktop_canvas = tk.Canvas(self, bg="#0f111a", highlightthickness=0)
        self.desktop_canvas.pack(fill='both', expand=True)
        self.desktop_canvas.bind("<Button-1>", lambda e: self.toggle_menu(force_close=True))

        # Welcome watermark on desktop
        self.desktop_canvas.create_text(
            40, 40, anchor="nw",
            text="LinDOS v1.0-beta\nUltra-Lean Gaming OS",
            fill="#45475a", font=('Sans', 16, 'bold')
        )

    def create_taskbar(self):
        # Bottom Taskbar Panel (resembling Windows/Linux panels)
        self.taskbar = tk.Frame(self, bg="#1e1e2e", height=45)
        self.taskbar.pack(side='bottom', fill='x')
        self.taskbar.pack_propagate(False)

        # OS Start/Menu Button
        self.btn_start = tk.Button(
            self.taskbar, text=" ❖ LinDOS ", bg="#89b4fa", fg="#11111b",
            font=('Sans', 10, 'bold'), relief='flat', bd=0,
            activebackground="#b4befe", activeforeground="#11111b",
            command=self.toggle_menu
        )
        self.btn_start.pack(side='left', padx=8, pady=6)

        # Taskbar Window / App Indicator Area
        self.task_indicator = tk.Label(
            self.taskbar, text="Workspace Active", bg="#1e1e2e", fg="#cdd6f4",
            font=('Sans', 9)
        )
        self.task_indicator.pack(side='left', padx=15)

        # Live Clock (Right side of taskbar)
        self.lbl_clock = tk.Label(
            self.taskbar, text="", bg="#1e1e2e", fg="#cdd6f4",
            font=('Sans', 10, 'bold')
        )
        self.lbl_clock.pack(side='right', padx=15)
        self.update_clock()

    def create_menu_popup(self):
        # Hidden OS Application Menu (pops up when clicking the Start button)
        self.menu_frame = tk.Frame(self, bg="#181825", bd=2, relief='solid')
        
        # Menu Header
        lbl_header = tk.Label(self.menu_frame, text=" System Applications ", bg="#181825", fg="#f38ba8", font=('Sans', 9, 'bold'))
        lbl_header.pack(anchor='w', padx=10, pady=8)

        # Menu Options with Mouse & Keyboard Support
        options = [
            ("⚡ Terminal Shell", self.action_terminal),
            ("🚀 Game Hub Execution", self.action_gamehub),
            ("📊 ZRAM Memory Status", self.action_zram),
            ("🔄 Reboot System", self.action_reboot),
            ("⏻ Power Off", self.destroy)
        ]

        for text, cmd in options:
            btn = tk.Button(
                self.menu_frame, text=text, bg="#181825", fg="#cdd6f4",
                font=('Sans', 10), anchor='w', relief='flat', bd=0,
                activebackground="#313244", activeforeground="#89b4fa",
                command=cmd
            )
            btn.pack(fill='x', padx=5, pady=2)

        self.menu_visible = False

    def toggle_menu(self, force_close=False):
        if self.menu_visible or force_close:
            self.menu_frame.place_forget()
            self.menu_visible = False
        else:
            # Place menu right above the start button
            self.menu_frame.place(x=8, y=self.winfo_height() - 220, width=220, height=170)
            self.menu_visible = True

    def update_clock(self):
        now = datetime.now().strftime("%H:%M:%S")
        self.lbl_clock.config(text=now)
        self.after(1000, self.update_clock)

    def action_terminal(self):
        self.task_indicator.config(text="Status: Terminal Shell Active")
        self.toggle_menu(force_close=True)

    def action_gamehub(self):
        self.task_indicator.config(text="Status: Game Hub Engine Running")
        self.toggle_menu(force_close=True)

    def action_zram(self):
        self.task_indicator.config(text="ZRAM: Active (Dynamic Pool Optimized)")
        self.toggle_menu(force_close=True)

    def action_reboot(self):
        self.destroy()

if __name__ == "__main__":
    app = LinDOSDesktop()
    app.mainloop()
