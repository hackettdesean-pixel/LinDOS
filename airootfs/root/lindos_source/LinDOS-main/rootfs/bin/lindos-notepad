#!/usr/bin/env python3
import tkinter as tk
from tkinter import scrolledtext

root = tk.Tk()
root.title("LinDOS Notepad")
root.geometry("500x400")
root.configure(bg="#1e1e2e")

text_area = scrolledtext.ScrolledText(root, wrap=tk.WORD, bg="#11111b", fg="#cdd6f4", insertbackground="white", font=('Sans', 10))
text_area.pack(fill='both', expand=True, padx=5, pady=5)

root.mainloop()
