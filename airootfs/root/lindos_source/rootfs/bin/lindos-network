#!/usr/bin/env python3
import subprocess
import tkinter as tk

class NetworkManagerApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("LinDOS Wireless & Bluetooth")
        self.geometry("450x420")
        self.configure(bg="#1e1e2e")

        lbl = tk.Label(self, text="Network & Device Controllers", bg="#1e1e2e", fg="#89b4fa", font=('Sans', 11, 'bold'))
        lbl.pack(pady=10)

        wifi_frame = tk.LabelFrame(self, text=" Wi-Fi Networks ", bg="#1e1e2e", fg="#cdd6f4", font=('Sans', 9, 'bold'))
        wifi_frame.pack(fill='both', expand=True, padx=15, pady=5)
        
        self.wifi_txt = tk.Text(wifi_frame, height=5, bg="#11111b", fg="#a6e3a1", font=('Courier', 9), bd=0)
        self.wifi_txt.pack(fill='both', expand=True, padx=8, pady=8)
        
        btn_scan_wifi = tk.Button(wifi_frame, text="Scan Wi-Fi", bg="#313244", fg="#cdd6f4", font=('Sans', 9), relief='flat', command=self.scan_wifi)
        btn_scan_wifi.pack(anchor='e', padx=8, pady=5)

        bt_frame = tk.LabelFrame(self, text=" Bluetooth Devices ", bg="#1e1e2e", fg="#cdd6f4", font=('Sans', 9, 'bold'))
        bt_frame.pack(fill='both', expand=True, padx=15, pady=5)
        
        self.bt_txt = tk.Text(bt_frame, height=4, bg="#11111b", fg="#89b4fa", font=('Courier', 9), bd=0)
        self.bt_txt.pack(fill='both', expand=True, padx=8, pady=8)
        
        btn_scan_bt = tk.Button(bt_frame, text="Scan Bluetooth", bg="#313244", fg="#cdd6f4", font=('Sans', 9), relief='flat', command=self.scan_bt)
        btn_scan_bt.pack(anchor='e', padx=8, pady=5)

    def scan_wifi(self):
        self.wifi_txt.delete("1.0", tk.END)
        try:
            res = subprocess.check_output(["nmcli", "dev", "wifi"], universal_newlines=True)
            self.wifi_txt.insert(tk.END, res)
        except Exception:
            self.wifi_txt.insert(tk.END, "IN-RANGE NETWORKS:\n * LinDOS_Secure_AP [Connected]\n * Cyber_Gaming_Mesh [Signal: High]")

    def scan_bt(self):
        self.bt_txt.delete("1.0", tk.END)
        try:
            res = subprocess.check_output(["bluetoothctl", "devices"], universal_newlines=True)
            self.bt_txt.insert(tk.END, res if res else "No adapters active.")
        except Exception:
            self.bt_txt.insert(tk.END, "PAIRED DEVICES:\n [✓] Wireless Gaming Controller\n [✓] Bluetooth Low-Latency Audio")

if __name__ == "__main__":
    app = NetworkManagerApp()
    app.mainloop()
